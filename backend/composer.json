{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tap/prueba-desarrollo-api",
    "type": "project",
    "description": "API REST de la prueba técnica TAP: Laravel 11 + MongoDB con arquitectura hexagonal.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "firebase/php-jwt": "^7.2",
        "laravel/framework": "^11.31",
        "laravel/tinker": "^2.9",
        "mongodb/laravel-mongodb": "^5.8",
        "openspout/openspout": "^4.28",
        "pragmarx/google2fa": "^9.1",
        "propaganistas/laravel-phone": "^6.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.14",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tap\\": "src/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "pint --test"
        ],
        "format": [
            "pint"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.36"
        },
        "audit": {
            "ignore": {
                "PKSA-3r5d-mb8f-1qw9": "GHSA-5vg9-5847-vvmq (CRLF en la regla email): mitigado con email:strict + not_regex de caracteres de control + Value Object Email. Ver docs/SEGURIDAD.md §8.",
                "PKSA-mdq4-51ck-6kdq": "CVE-2026-48019: es el mismo aviso de CRLF que PKSA-3r5d-mb8f-1qw9, publicado por otra fuente. Mitigado igual.",
                "PKSA-m5cs-t1y6-qpcs": "GHSA-crmm-hgp2-wgrp (signed URLs temporales): no se usan las signed URLs de Laravel; las fotos usan firma HMAC propia (MediaUrlSigner).",
                "PKSA-d5tc-s1qs-h781": "GHSA-jh5r-qr3c-85q8 (XSS en la página de depuración): APP_DEBUG=false en todos los entornos.",
                "PKSA-yxbx-3c9s-cjt9": "GHSA-63hm-g96r-2m2q (Concurrency::run): el facade Concurrency no se usa."
            },
            "abandoned": "fail"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
