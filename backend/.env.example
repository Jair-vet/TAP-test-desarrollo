# =============================================================================
# Backend (Laravel). En Docker estas variables llegan desde ../.env vía
# docker-compose.yml; este archivo documenta cada una.
# =============================================================================
APP_NAME="TAP Prueba API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Mexico_City
APP_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- MongoDB (usuario con rol readWrite SOLO sobre la BD tap) ---
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://tap_app:CHANGE_ME@mongo:27017/tap?authSource=tap
MONGODB_DATABASE=tap

# --- Redis (caché, colas, rate limiting, revocación de JWT) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# --- Correo (Mailpit en local; en producción SMTP real/SES) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@tap.test
MAIL_FROM_NAME="Sistema de Gestión TAP"

# --- Seguridad (config/security.php) ---
HASH_DRIVER=argon2id
JWT_ISSUER=tap-api
JWT_AUDIENCE=tap-web
JWT_ACCESS_TTL=600
JWT_MFA_TTL=300
REFRESH_TTL=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TEMP_PASSWORD_TTL=60
TWO_FACTOR_ISSUER="TAP Prueba"
TWO_FACTOR_REQUIRED=false

# --- Usuarios demo ---
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_DEMO_PASSWORD=CHANGE_ME
