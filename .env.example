# =============================================================================
# Variables del stack Docker. `make setup` copia este archivo a .env y rellena
# los secretos con valores aleatorios (openssl rand). NUNCA subas .env a Git.
# =============================================================================
WEB_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_KEY=
APP_DISPLAY_TIMEZONE=America/Mexico_City

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# Acceso a la bandeja de correos de prueba en /mail
MAILPIT_UI_USER=revisor
MAILPIT_UI_PASSWORD=

# Usuarios demo (admin@tap.test y los de perfil Almacén/Consulta/RH)
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Seguridad
JWT_ACCESS_TTL=600
REFRESH_TTL=604800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TWO_FACTOR_REQUIRED=false
